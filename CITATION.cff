    family-names: Mathieu
    email: alexandre.mathieu@pasteur.fr
    affiliation: Institut Pasteur
  - given-names: Freddy
    family-names: Cliquet
    email: freddy.cliquet@gmail.com
version: 0.6.1
date-released: "2026-11-18"
# Concept DOI: every release, resolving to the latest. Each release also
# gets its own version DOI on Zenodo (0.4.4: 10.5281/zenodo.24289472).
doi: 10.5281/zenodo.24289471
identifiers:
  - type: doi
    value: 10.5281/zenodo.24289471
    description: All versions of pypedigree, archived on Zenodo
license: MIT
repository-code: "https://github.com/bourgeron-lab/pypedigree"
url: "https://github.com/bourgeron-lab/pypedigree"
keywords:
